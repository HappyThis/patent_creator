# Shared dev environment
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000

# Backend workspace
PATENT_CREATOR_DATA_DIR=~/.patent_creator
PATENT_CREATOR_GIT_USER_NAME=PatentCreator
PATENT_CREATOR_GIT_USER_EMAIL=patent-creator@local
PATENT_CREATOR_ROUND_STEP_DELAY=0.15
PATENT_CREATOR_ROUND_FINISH_DELAY=0.1
PATENT_CREATOR_LLM_TIMEOUT=45
PATENT_CREATOR_LLM_MAX_RETRIES=2
PATENT_CREATOR_CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# OpenAI Responses API
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=high
OPENAI_MAX_OUTPUT_TOKENS=8192
OPENAI_WEB_SEARCH_ENABLED=true
OPENAI_WEB_SEARCH_CONTEXT_SIZE=low

PATENT_CREATOR_CONTEXT_MAX_TOKENS=128000
PATENT_CREATOR_CONTEXT_COMPRESS_THRESHOLD_RATIO=0.8
PATENT_CREATOR_CONTEXT_COMPRESSION_TIMEOUT=300
PATENT_CREATOR_CONTEXT_TOKEN_CHAR_COEFFICIENT=0.5

# Logging
PATENT_CREATOR_LOG_DIR=
PATENT_CREATOR_LOG_LEVEL=INFO
PATENT_CREATOR_LOG_BACKUP_DAYS=30
PATENT_CREATOR_LOG_LLM_PAYLOAD=false
