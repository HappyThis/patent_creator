{
  "id": "software_patent_solution_github",
  "name": "GitHub 中型项目软件专利技术方案评测基准",
  "benchmark_version": "0.1.0",
  "status": "草稿",
  "context_shape": "prepared_project_environment",
  "task_type": "software_patent_technical_solution_generation",
  "description": "评估本系统完整主 agent 是否能够在已准备好的项目环境中，以技术方案需求文本作为任务输入，主动阅读项目上下文，并将软件专利技术方案落实到 disclosure 的技术方案章节。",
  "agent_visible_inputs": [
    "runner.md",
    "cases/<case_id>/request.md",
    "prepared project checkout as current working directory or environment path"
  ],
  "hidden_inputs": [
    "judge.md",
    "cases/<case_id>/snapshot.json",
    "cases/<case_id>/snapshot.json focus_paths",
    "cases/<case_id>/reference_solution.md",
    "cases/<case_id>/rubric.md",
    "cases/<case_id>/metadata.json"
  ],
  "scoring": {
    "total_points": 100,
    "dimensions": [
      {
        "id": "environment_reading_requirement_understanding",
        "name": "环境阅读与需求理解",
        "points": 15
      },
      {
        "id": "technical_problem",
        "name": "技术问题识别",
        "points": 15
      },
      {
        "id": "technical_means",
        "name": "技术手段具体性",
        "points": 20
      },
      {
        "id": "essential_features",
        "name": "必要技术特征完整性",
        "points": 10
      },
      {
        "id": "closed_loop",
        "name": "问题-手段-效果闭环",
        "points": 15
      },
      {
        "id": "requirement_constraints",
        "name": "需求约束遵守",
        "points": 10
      },
      {
        "id": "implementability",
        "name": "可实施性",
        "points": 10
      },
      {
        "id": "patent_value",
        "name": "专利化价值",
        "points": 5
      }
    ]
  },
  "source_project_ids": [
    "builderz_labs_mission_control",
    "campfirein_byterover_cli",
    "cloudflare_agents"
  ],
  "case_ids": [
    "001",
    "002",
    "003",
    "004",
    "005",
    "006",
    "007",
    "008",
    "009",
    "010"
  ],
  "projects_dir": "projects",
  "agent_input_contract": {
    "ordered_text_parts": [
      "runner.md",
      "optional single-line project environment path only when cwd cannot be set",
      "cases/<case_id>/request.md"
    ],
    "environment": "prepared project checkout at snapshot commit, preferably set as current working directory",
    "forbidden_text_inputs": [
      "cases/<case_id>/snapshot.json content",
      "focus_paths or suggested source paths",
      "cases/<case_id>/metadata.json",
      "cases/<case_id>/reference_solution.md",
      "cases/<case_id>/rubric.md",
      "source issue or PR links and summaries",
      "final implementation diff",
      "case difficulty, tags, scoring dimensions, or selection notes"
    ]
  },
  "target_system": {
    "primary_subject": "patent_creator technical-solution-generation agent",
    "description": "正式主评测评估本系统中负责生成软件专利技术方案草稿的 agent 能力。外部 coding agent 或模型接口只能作为执行后端、调试工具或对照组，不应被解释为主评测对象。",
    "allowed_execution_backends": [
      "local system agent runtime",
      "model provider used by the system agent",
      "external agent wrapper only when it faithfully invokes the system agent capability"
    ],
    "not_primary_subjects": [
      "generic Codex coding agent ability",
      "generic Claude Code ability",
      "generic Cursor agent ability"
    ]
  },
  "evaluation_artifact": {
    "source": "disclosure.json",
    "section_id": "technical_solution",
    "output_file": "evaluated_artifact.md",
    "scored_content": "only the content extracted from the technical_solution section",
    "excluded_from_scoring": [
      "final chat reply",
      "tool call trace",
      "subagent proposal",
      "session events",
      "document diff"
    ],
    "no_fallback_to_reply": true
  },
  "runner_policy": {
    "subject_entrypoint": "full main agent chat interface",
    "max_refinement_rounds_when_artifact_missing": 2,
    "refinement_instruction": "请继续充实交底书中的“技术方案”章节。只允许编辑“技术方案”章节，不要编辑技术领域、背景技术、现有技术方案、现有技术缺陷、要解决的技术问题、技术效果等其他章节。",
    "skip_status_when_missing_after_refinement": "skipped_no_solution_artifact"
  }
}
